# Azure OpenAI Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Azure OpenAI Service Endpoint
# Format: https://<your-resource-name>.openai.azure.com/
# AZURE_OPENAI_ENDPOINT=https://flashcast-chat.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://flashcast-chat-dev.openai.azure.com

# Deployment name for your GPT-4 model
# Example: gpt-4-turbo, gpt-4-1106-preview
# AZURE_OPENAI_DEPLOYMENT=flashcast-gpt-4.1
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
# AZURE_OPENAI_DEPLOYMENT=gpt-5.2

# API version (use latest stable version)
# Example: 2024-02-15-preview
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Image Generation Configuration (DALL-E)
# Endpoint for image generation (use flashcast-chat-dev for DALL-E)
AZURE_OPENAI_IMAGE_ENDPOINT=https://flashcast-chat-dev.cognitiveservices.azure.com/
DEPLOYMENT_NAME=gpt-image-1
OPENAI_API_VERSION=2025-04-01-preview

SPEECH_API_REGION=eastus
SPEECH_RESOURCE_ID=/subscriptions/74903b64-1ec7-4e9c-a8a8-7147803bd997/resourceGroups/flashcast/providers/Microsoft.CognitiveServices/accounts/flashcast-speech

# Optional: Cache directory for enriched styles
# Default: .cache/enriched
ENRICHED_STYLE_CACHE_DIR=.cache/enriched

# Optional: Logging level
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Serper.dev API key for web/image search
SERPER_API_KEY=

SERP_API_KEY=